# ============================================================
# RAG 知识库配置（复制本文件为 .env 后填写）
# 切换在线/本地模型 = 改下面「模型供应商」区段的几行，其余不用动
# ============================================================

# ─────────────────────────────────────────────
# ① 在线模型 · 智谱 GLM（默认启用，一个 Key 同时提供对话+向量模型）
#    申请 Key: https://open.bigmodel.cn  (glm-4-flash 免费，可先零成本跑通)
# ─────────────────────────────────────────────
LLM_BINDING=openai
LLM_MODEL=glm-4-flash
LLM_BINDING_HOST=https://open.bigmodel.cn/api/paas/v4
LLM_BINDING_API_KEY=在这里填智谱APIKey
LLM_BINDING_MAX_ASYNC=4

EMBEDDING_BINDING=openai
EMBEDDING_MODEL=embedding-3
EMBEDDING_BINDING_HOST=https://open.bigmodel.cn/api/paas/v4
EMBEDDING_BINDING_API_KEY=在这里填智谱APIKey
EMBEDDING_DIM=2048
EMBEDDING_BATCH_SIZE=10
EMBEDDING_FUNC_MAX_ASYNC=4

# ─────────────────────────────────────────────
# ② 在线模型 · DeepSeek（对话强，无向量接口，向量用硅基流动免费 bge-m3）
#    申请 Key: https://platform.deepseek.com  https://siliconflow.cn
# ─────────────────────────────────────────────
# LLM_BINDING=openai
# LLM_MODEL=deepseek-chat
# LLM_BINDING_HOST=https://api.deepseek.com
# LLM_BINDING_API_KEY=在这里填DeepSeek APIKey
# LLM_BINDING_MAX_ASYNC=4
#
# EMBEDDING_BINDING=openai
# EMBEDDING_MODEL=BAAI/bge-m3
# EMBEDDING_BINDING_HOST=https://api.siliconflow.cn/v1
# EMBEDDING_BINDING_API_KEY=在这里填硅基流动APIKey
# EMBEDDING_DIM=1024
# EMBEDDING_BATCH_SIZE=16
# EMBEDDING_FUNC_MAX_ASYNC=4

# ─────────────────────────────────────────────
# ③ 在线模型 · 阿里通义 Qwen（一个 Key 提供对话+向量）
#    申请 Key: https://bailian.console.aliyun.com
# ─────────────────────────────────────────────
# LLM_BINDING=openai
# LLM_MODEL=qwen-plus
# LLM_BINDING_HOST=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_BINDING_API_KEY=在这里填阿里云百炼APIKey
# LLM_BINDING_MAX_ASYNC=4
#
# EMBEDDING_BINDING=openai
# EMBEDDING_MODEL=text-embedding-v4
# EMBEDDING_BINDING_HOST=https://dashscope.aliyuncs.com/compatible-mode/v1
# EMBEDDING_BINDING_API_KEY=同上
# EMBEDDING_DIM=1024
# EMBEDDING_BATCH_SIZE=10
# EMBEDDING_FUNC_MAX_ASYNC=4

# ─────────────────────────────────────────────
# ④ 本地模型 · Ollama（完全离线；先安装 https://ollama.com 并拉取模型）
#    ollama pull qwen3:8b && ollama pull bge-m3
#    注意：机器配置建议 ≥16G 内存；切换后需删除 data/rag_storage 重新入库
# ─────────────────────────────────────────────
# LLM_BINDING=ollama
# LLM_MODEL=qwen3:8b
# LLM_BINDING_HOST=http://localhost:11434
# LLM_BINDING_API_KEY=ollama
# LLM_BINDING_MAX_ASYNC=2
#
# EMBEDDING_BINDING=ollama
# EMBEDDING_MODEL=bge-m3
# EMBEDDING_BINDING_HOST=http://localhost:11434
# EMBEDDING_BINDING_API_KEY=ollama
# EMBEDDING_DIM=1024
# EMBEDDING_BATCH_SIZE=8
# EMBEDDING_FUNC_MAX_ASYNC=2

# ─────────────────────────────────────────────
# ⑤ 在线模型 · OpenAI 官方（需可访问国际网络）
# ─────────────────────────────────────────────
# LLM_BINDING=openai
# LLM_MODEL=gpt-4o-mini
# LLM_BINDING_HOST=https://api.openai.com/v1
# LLM_BINDING_API_KEY=sk-...
# LLM_BINDING_MAX_ASYNC=4
#
# EMBEDDING_BINDING=openai
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_BINDING_HOST=https://api.openai.com/v1
# EMBEDDING_BINDING_API_KEY=sk-...
# EMBEDDING_DIM=1536
# EMBEDDING_BATCH_SIZE=32
# EMBEDDING_FUNC_MAX_ASYNC=8

# ============================================================
# 存储配置（默认零部署：Milvus Lite 内嵌库；数据量大时切 Docker 版 Milvus）
# ============================================================
WORKING_DIR=./data/rag_storage
VECTOR_STORAGE=MilvusVectorDBStorage
# lightrag-server 读的是带 LIGHTRAG_ 前缀的变量（与上面等价，两处都写保证脚本和 WebUI 一致）
LIGHTRAG_VECTOR_STORAGE=MilvusVectorDBStorage
LIGHTRAG_KV_STORAGE=JsonKVStorage
LIGHTRAG_GRAPH_STORAGE=NetworkXStorage
LIGHTRAG_DOC_STATUS_STORAGE=JsonDocStatusStorage

# 方式 A：Milvus Lite（默认）——向量库就是下面的本地文件，无需安装任何服务。
# 注意：不要把文件路径写进 MILVUS_URI（pymilvus 会校验该变量必须是 http 地址），
# Lite 模式请保持 MILVUS_URI 留空，只用 MILVUS_LITE_PATH。
MILVUS_LITE_PATH=./data/milvus_lite.db
MILVUS_DB_NAME=default

# 方式 B：Docker 版 Milvus（先 `make milvus-up` 启动，再取消下面三行注释）
# MILVUS_URI=http://localhost:19530
# MILVUS_USER=root
# MILVUS_PASSWORD=Milvus

# ============================================================
# Web 服务（WebUI 知识库工作台）
# ============================================================
HOST=127.0.0.1
PORT=9621
# 启动时自动入库 docs/ 目录下的文档（内容相同会自动去重）
INPUT_DIR=./docs
# 实体/关系抽取语言
SUMMARY_LANGUAGE=chinese

# 给知识库 API 设访问口令（可选，局域网/云端部署时建议打开）
# LIGHTRAG_API_KEY=my-secret-key
# WebUI 登录账号（可选）
# AUTH_ACCOUNTS=admin,admin123

# 并行入库任务数（在线模型 2~4，本地模型 1~2）
MAX_PARALLEL_INSERT=2
